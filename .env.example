# SynxEx Marketing Website — Auth0 Next.js Environment Configuration
# Copy to .env.local or configure in Vercel Project Settings for synxex-marketing.

# The base URL of this application
APP_BASE_URL=https://synxex-chi.vercel.app

# A 32-byte secret used to encrypt the session cookie (Generate using: openssl rand -hex 32)
AUTH0_SECRET=replace-with-a-random-32-byte-secret-hex-string

# The URL of your Auth0 tenant domain (e.g., https://synxex.us.auth0.com)
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

# The Client ID of the "Regular Web Application" configured in Auth0 Dashboard
AUTH0_CLIENT_ID=your-auth0-regular-web-app-client-id

# The Client Secret of the "Regular Web Application" configured in Auth0 Dashboard (Server-only)
AUTH0_CLIENT_SECRET=your-auth0-client-secret-do-not-expose-in-frontend

# Web Application Root URL (Destination for SSO redirect)
NEXT_PUBLIC_APP_URL=https://synxex-app.vercel.app

